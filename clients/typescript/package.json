{
  "name": "@sqlanywhere/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "The SQL Anywhere storage contracts (queue, cache, pub/sub) as a typed TypeScript API, generated from docs/contracts.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test"
  },
  "devDependencies": {
    "@libsql/client": "0.15.15",
    "@types/node": "22.15.21",
    "typescript": "5.9.3"
  }
}
